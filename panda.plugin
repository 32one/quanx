#!name=KBJ Panda Live Rewriter
#!desc=为 kbjgirl.com 加载的 PandaTV FLV 直播流强制注入 Origin 头。用 Loon 标准 [Script] http-request + JS 脚本改头（v1.x 的 [Header] 区块不是标准语法，整段被 Loon 忽略了）。
#!version=2.0.0
#!date=2026-09-10 08:50:00
#!homepage=https://kbjgirl.com/panda-live
#!openUrl=https://kbjgirl.com/panda-live

[MITM]
# 明确列出所有 CDN 子域
hostname = pandatv.co.kr, *.pandatv.co.kr, cdn-live.pandatv.co.kr, cdn-live-01.pandatv.co.kr, cdn-live-02.pandatv.co.kr, cdn-live-03.pandatv.co.kr, pandalive.co.kr, *.pandalive.co.kr, live-video.net, *.live-video.net

[Script]
# 用 http-request + JS 脚本改 Origin（Loon 官方推荐方式）
# 三条规则：pandatv.co.kr / pandalive.co.kr / live-video.net
http-request ^https?://[^/]*pandatv\.co\.kr/.* requires-body=false, script-path=https://raw.githubusercontent.com/32one/quanx/main/panda-origin.js, timeout=10, tag=KBJ-Panda-Origin
http-request ^https?://[^/]*pandalive\.co\.kr/.* requires-body=false, script-path=https://raw.githubusercontent.com/32one/quanx/main/panda-origin.js, timeout=10, tag=KBJ-Panda-Origin
http-request ^https?://[^/]*live-video\.net/.* requires-body=false, script-path=https://raw.githubusercontent.com/32one/quanx/main/panda-origin.js, timeout=10, tag=KBJ-Panda-Origin
